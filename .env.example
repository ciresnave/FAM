# FAM (Federated Agent Messaging) Environment Variables

# ============================================================================
# Required
# ============================================================================

# Server secret for token hashing (generate a random string)
FAM_SERVER_SECRET=your-secret-here

# ============================================================================
# OAuth Providers (at least one required for authentication)
# ============================================================================

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# Server Configuration
# ============================================================================

# Server port (default: 7900 - deliberately NOT 7899, which the claude-peers
# broker binds, so both can run side by side during a migration)
FAM_PORT=7900

# Server host (default: 127.0.0.1)
FAM_HOST=127.0.0.1

# Full server URL (used in OAuth callbacks)
FAM_SERVER_URL=http://localhost:7900

# Database path (default: ~/.fam.db)
FAM_DB_PATH=~/.fam.db

# ============================================================================
# CORS
# ============================================================================

# Allowed origins (comma-separated, default: http://localhost:3000)
FAM_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# Rate Limiting
# ============================================================================

# Max request body size in bytes (default: 1048576 = 1MB)
FAM_MAX_BODY_SIZE=1048576

# ============================================================================
# Data Retention
# ============================================================================

# Message retention period in days (default: 30, 0 = disable cleanup)
FAM_MESSAGE_RETENTION_DAYS=30

# ============================================================================
# Encryption at Rest
# ============================================================================

# Encrypt message content in the database (default: false)
# WARNING: Rotating FAM_SERVER_SECRET makes existing encrypted messages
# permanently undecryptable. Plan a migration before rotating.
FAM_ENCRYPT_MESSAGES=false

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARN, ERROR, SILENT (default: INFO)
FAM_LOG_LEVEL=INFO

# ============================================================================
# CLI Configuration
# ============================================================================

# Passkey for encrypting/decrypting private keys
FAM_PASSKEY=your-passkey-here

# Server URL for CLI (default: http://127.0.0.1:7900)
FAM_CLI_SERVER_URL=http://127.0.0.1:7900

# ============================================================================
# MCP Adapter Configuration
# ============================================================================

# WebSocket URL (default: ws://127.0.0.1:7900/ws)
FAM_WS_URL=ws://127.0.0.1:7900/ws

# Path to credentials file (default: ~/.fam/credentials.json)
FAM_CREDENTIALS=~/.fam/credentials.json
